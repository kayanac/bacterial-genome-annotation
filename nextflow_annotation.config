nextflow.enable.dsl = 2

params {
  work_dir = System.getenv('NXF_WORK') ?: "${launchDir}/work"
  bakta_db = System.getenv('BAKTA_DB') ?: ''
  genomad_db = System.getenv('GENOMAD_DB') ?: ''
  mob_db = System.getenv('MOB_DB') ?: ''
  staramr_db = System.getenv('STARAMR_DB') ?: ''
  amrfinder_db = System.getenv('AMRFINDER_DB') ?: ''
}

workDir = params.work_dir

/* Allow Nextflow to overwrite trace/report/timeline/dag files */
trace {
  enabled = true
  overwrite = true
  file = 'trace.txt'
}

report {
  enabled = true
  overwrite = true
  file = 'report.html'
}

timeline {
  enabled = true
  overwrite = true
  file = 'timeline.html'
}

dag {
  enabled = true
  overwrite = true
  file = 'pipeline-dag.png'
}

process {
  executor = 'local'
  cpus = 4
  memory = '32 GB'
  time = '06h'
  stageInMode = 'copy'
  stageOutMode = 'copy'
}

profiles {
  standard { }

  local {
    process.executor = 'local'
    singularity {
      enabled = true
      autoMounts = true
      runOptions = [
        "--cleanenv",
        "--bind '${params.bakta_db}:${params.bakta_db}:ro'",
        "--bind '${params.genomad_db}:${params.genomad_db}:ro'",
        "--bind '${params.mob_db}:${params.mob_db}:ro'",
        "--bind '${params.staramr_db}:${params.staramr_db}:ro'",
        "--bind '${params.amrfinder_db}:${params.amrfinder_db}:ro'"
      ].join(' ')
    }
  }

  docker_local {
    process.executor = 'local'
    docker {
      enabled = true
      runOptions = [
        "-v '${params.bakta_db}:${params.bakta_db}:ro'",
        "-v '${params.genomad_db}:${params.genomad_db}:ro'",
        "-v '${params.mob_db}:${params.mob_db}:ro'",
        "-v '${params.staramr_db}:${params.staramr_db}:ro'",
        "-v '${params.amrfinder_db}:${params.amrfinder_db}:ro'"
      ].join(' ')
    }
  }

  slurm {
    process.executor = 'slurm'
    singularity {
      enabled = true
      autoMounts = true
      runOptions = [
        "--cleanenv",
        "--bind '${params.bakta_db}:${params.bakta_db}:ro'",
        "--bind '${params.genomad_db}:${params.genomad_db}:ro'",
        "--bind '${params.mob_db}:${params.mob_db}:ro'",
        "--bind '${params.staramr_db}:${params.staramr_db}:ro'",
        "--bind '${params.amrfinder_db}:${params.amrfinder_db}:ro'"
      ].join(' ')
    }
  }

  // Backward-compatible profile name used by the original run command.
  singularity {
    process.executor = 'slurm'
    singularity {
      enabled = true
      autoMounts = true
      runOptions = [
        "--cleanenv",
        "--bind '${params.bakta_db}:${params.bakta_db}:ro'",
        "--bind '${params.genomad_db}:${params.genomad_db}:ro'",
        "--bind '${params.mob_db}:${params.mob_db}:ro'",
        "--bind '${params.staramr_db}:${params.staramr_db}:ro'",
        "--bind '${params.amrfinder_db}:${params.amrfinder_db}:ro'"
      ].join(' ')
    }
  }
}
